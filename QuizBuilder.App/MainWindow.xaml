<Window x:Class="QuizBuilder.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quiz Builder - Toolchain Probe"
        Height="760" Width="900"
        MinHeight="400" MinWidth="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Background}">

    <!--
      PROBE WINDOW. Deliberately minimal. It exists to prove four things at
      once, each of which is a separate failure mode:

        1. The WPF toolchain builds a net8.0-windows project at all.
        2. DI reaches the window (the version text is injected, not hardcoded).
        3. Theme tokens survive Core -> ThemeResourceBuilder -> XAML.
           Every colour and font below is a DynamicResource lookup; if the
           bridge is broken these render as system defaults and it is obvious.
        4. An 8-digit overlay token parses with alpha in the right position.
           The swatch strip includes one; if alpha ordering were wrong it
           would show as a solid muddy colour instead of a faint tint.
    -->

    <!--
      ScrollViewer, not a bare Grid.

      Without it WPF silently clips: a StackPanel lays out children in order and
      simply stops when it runs out of height, so the LAST child vanishes with
      no scrollbar and no error. Shrinking this window by ~60px made the swatch
      caption disappear entirely, which is exactly the failure mode a 7-tab app
      with variable-length content would hit constantly.

      Every row is Auto: nothing should absorb slack by squeezing its children.
      If the content is taller than the viewport, the user scrolls.

      Spacing goes on the inner Grid's Margin rather than the ScrollViewer's
      Padding. Padding here would sit INSIDE the scrollable extent, so the
      bottom 24px would scroll away with the content and the scrollbar itself
      would be inset from the window edge, which looks wrong.
    -->
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Focusable="False">
    <Grid Margin="{DynamicResource Thickness.Lg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Headline: proves font family + size ramp resolve -->
        <TextBlock Grid.Row="0"
                   Text="Quiz Builder"
                   FontFamily="{DynamicResource Font.Family}"
                   FontSize="{DynamicResource Font.Size.Display}"
                   FontWeight="{DynamicResource Font.Weight.Bold}"
                   Foreground="{DynamicResource Brush.TextPrimary}" />

        <TextBlock Grid.Row="1"
                   Text="Toolchain probe - if this is styled, the shell works."
                   Margin="0,4,0,0"
                   FontFamily="{DynamicResource Font.Family}"
                   FontSize="{DynamicResource Font.Size.Body}"
                   Foreground="{DynamicResource Brush.TextSecondary}" />

        <!-- Injected values: proves DI reached the window -->
        <Border Grid.Row="2"
                Margin="0,24,0,0"
                Padding="{DynamicResource Thickness.Md}"
                Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.BorderStrong}"
                BorderThickness="{DynamicResource Border.Width}"
                CornerRadius="{DynamicResource Radius.Md}">
            <StackPanel>
                <TextBlock Text="Injected from the DI container"
                           FontFamily="{DynamicResource Font.Family}"
                           FontSize="{DynamicResource Font.Size.Caption}"
                           Foreground="{DynamicResource Brush.TextSecondary}" />
                <TextBlock x:Name="DiagnosticsText"
                           Margin="0,8,0,0"
                           FontFamily="{DynamicResource Font.Family.Mono}"
                           FontSize="{DynamicResource Font.Size.Body}"
                           Foreground="{DynamicResource Brush.TextPrimary}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- Swatches: proves colour tokens, including an alpha overlay -->
        <Border Grid.Row="3"
                Margin="0,16,0,0"
                Padding="{DynamicResource Thickness.Md}"
                Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="{DynamicResource Border.Width}"
                CornerRadius="{DynamicResource Radius.Md}">
            <StackPanel>
                <TextBlock Text="Theme tokens"
                           FontFamily="{DynamicResource Font.Family}"
                           FontSize="{DynamicResource Font.Size.Caption}"
                           Foreground="{DynamicResource Brush.TextSecondary}" />

                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Border Width="64" Height="40" CornerRadius="{DynamicResource Radius.Sm}"
                            Background="{DynamicResource Brush.Primary}" Margin="0,0,8,0" />
                    <Border Width="64" Height="40" CornerRadius="{DynamicResource Radius.Sm}"
                            Background="{DynamicResource Brush.Accent}" Margin="0,0,8,0" />
                    <Border Width="64" Height="40" CornerRadius="{DynamicResource Radius.Sm}"
                            Background="{DynamicResource Brush.Success}" Margin="0,0,8,0" />
                    <Border Width="64" Height="40" CornerRadius="{DynamicResource Radius.Sm}"
                            Background="{DynamicResource Brush.Warning}" Margin="0,0,8,0" />
                    <Border Width="64" Height="40" CornerRadius="{DynamicResource Radius.Sm}"
                            Background="{DynamicResource Brush.Error}" Margin="0,0,8,0" />

                    <!-- The alpha test. This must render as a FAINT tint over
                         the surface. A solid or muddy block means the 8-digit
                         token was parsed with alpha in the wrong position. -->
                    <Border Width="64" Height="40" CornerRadius="{DynamicResource Radius.Sm}"
                            Background="{DynamicResource Brush.SelectedOverlay}"
                            BorderBrush="{DynamicResource Brush.Border}"
                            BorderThickness="1" />
                </StackPanel>

                <TextBlock Text="Last swatch is an 8-digit alpha overlay: it should be a faint tint, not solid."
                           Margin="0,8,0,0"
                           FontFamily="{DynamicResource Font.Family}"
                           FontSize="{DynamicResource Font.Size.Caption}"
                           Foreground="{DynamicResource Brush.TextSecondary}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- Focus ring check: tab to this button, the ring must be visible.
             MinHeight is defensive: the button rendered as a 13px bare bar
             with no text when the ScrollViewer's viewport ran short, which is
             less than its own 16px of vertical padding. A control should never
             arrange smaller than its content needs, so pin a floor rather than
             trust the layout pass. 32px is the standard WPF button height and
             comfortably clears a 14px body line plus padding. -->
        <Button Grid.Row="4"
                x:Name="ProbeButton"
                Content="Focusable control (press Tab)"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                MinHeight="32"
                Margin="0,16,0,0"
                Padding="16,8"
                FontFamily="{DynamicResource Font.Family}"
                FontSize="{DynamicResource Font.Size.Body}"
                Background="{DynamicResource Brush.Primary}"
                Foreground="{DynamicResource Brush.OnPrimary}"
                BorderThickness="0" />
    </Grid>
    </ScrollViewer>
</Window>
