<Window x:Class="QuizBuilder.App.Views.SpellCheckWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:QuizBuilder.App.Converters"
        Title="Check spelling"
        Height="640" Width="720"
        MinHeight="420" MinWidth="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Background}">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolVis" />
        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource Font.Family}" />
            <Setter Property="FontSize" Value="{DynamicResource Font.Size.Body}" />
            <Setter Property="FontWeight" Value="{DynamicResource Font.Weight.Bold}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        </Style>

        <Style x:Key="Word" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource Font.Family}" />
            <Setter Property="FontSize" Value="{DynamicResource Font.Size.Body}" />
            <Setter Property="FontWeight" Value="{DynamicResource Font.Weight.Medium}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Error}" />
        </Style>

        <Style x:Key="Context" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource Font.Family}" />
            <Setter Property="FontSize" Value="{DynamicResource Font.Size.Caption}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="Where" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource Font.Family}" />
            <Setter Property="FontSize" Value="{DynamicResource Font.Size.Caption}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextDisabled}" />
        </Style>

        <Style x:Key="Action" TargetType="Button">
            <Setter Property="FontFamily" Value="{DynamicResource Font.Family}" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="MinWidth" Value="72" />
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Summary line -->
        <TextBlock Grid.Row="0"
                   Text="{Binding SummaryText}"
                   Style="{StaticResource Heading}"
                   Margin="0,0,0,12" />

        <!-- Empty state -->
        <TextBlock Grid.Row="1"
                   Text="Nothing to review. Every word was recognised."
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center">
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource Context}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasIssues}" Value="False">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <!-- Grouped issues -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding HasIssues, Converter={StaticResource BoolVis}}">
            <ItemsControl ItemsSource="{Binding Groups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,16">
                            <!-- Section heading -->
                            <Border Background="{DynamicResource Brush.SurfaceSunken}"
                                    Padding="10,6" Margin="0,0,0,6">
                                <TextBlock Style="{StaticResource Heading}">
                                    <Run Text="{Binding Heading, Mode=OneWay}" />
                                    <Run Text=" (" Foreground="{DynamicResource Brush.TextSecondary}" /><Run
                                         Text="{Binding Count, Mode=OneWay}"
                                         Foreground="{DynamicResource Brush.TextSecondary}" /><Run
                                         Text=")" Foreground="{DynamicResource Brush.TextSecondary}" />
                                </TextBlock>
                            </Border>

                            <!-- Issue rows -->
                            <ItemsControl ItemsSource="{Binding Issues}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource Brush.Surface}"
                                                BorderBrush="{DynamicResource Brush.Border}"
                                                BorderThickness="1"
                                                Padding="10,8" Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Word}"
                                                                   Style="{StaticResource Word}" />
                                                        <TextBlock Text="{Binding Where}"
                                                                   Style="{StaticResource Where}"
                                                                   Margin="8,0,0,0"
                                                                   VerticalAlignment="Center" />
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Context}"
                                                               Style="{StaticResource Context}"
                                                               Margin="0,2,8,0" />
                                                </StackPanel>

                                                <!-- Suggestion picker -->
                                                <ComboBox Grid.Column="1"
                                                          Width="150"
                                                          VerticalAlignment="Center"
                                                          ItemsSource="{Binding Suggestions}"
                                                          SelectedItem="{Binding SelectedSuggestion}"
                                                          IsEnabled="{Binding HasSuggestions}" />

                                                <Button Grid.Column="2"
                                                        Content="Replace"
                                                        Style="{StaticResource Action}"
                                                        IsEnabled="{Binding CanReplace}"
                                                        Click="OnReplaceClick"
                                                        Tag="{Binding}" />

                                                <Button Grid.Column="3"
                                                        Content="Ignore"
                                                        Style="{StaticResource Action}"
                                                        ToolTip="Add this word to your dictionary so it is never flagged"
                                                        Click="OnIgnoreClick"
                                                        Tag="{Binding}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Footer -->
        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Re-check"
                    Style="{StaticResource Action}"
                    Click="OnRecheckClick" />
            <Button Content="Close"
                    Style="{StaticResource Action}"
                    Background="{DynamicResource Brush.Primary}"
                    Foreground="{DynamicResource Brush.OnPrimary}"
                    BorderThickness="0"
                    Click="OnCloseClick" />
        </StackPanel>
    </Grid>
</Window>
