<UserControl x:Class="QuizBuilder.App.Views.StudyCardsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:QuizBuilder.App.Converters">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolVis" />
        <conv:BoolToVisibilityConverter x:Key="BoolVisInv" Invert="True" />
        <conv:BytesToImageConverter x:Key="BytesToImage" />
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Study cards"
                           FontFamily="{DynamicResource Font.Family}"
                           FontSize="{DynamicResource Font.Size.Title}"
                           FontWeight="{DynamicResource Font.Weight.Bold}"
                           Foreground="{DynamicResource Brush.TextPrimary}" />

                <TextBlock Text="Front/back cards you write by hand — terms, definitions, facts. They feed the Flash Cards tab when its source includes study cards."
                           FontFamily="{DynamicResource Font.Family}"
                           FontSize="{DynamicResource Font.Size.Caption}"
                           Foreground="{DynamicResource Brush.TextSecondary}"
                           TextWrapping="Wrap"
                           MaxWidth="520"
                           HorizontalAlignment="Left"
                           Margin="0,4,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Content="Check spelling"
                        Click="OnCheckSpellingClick"
                        Padding="14,8"
                        Margin="0,0,8,0"
                        Cursor="Hand"
                        ToolTip="Scan the whole quiz, including these study cards, for spelling issues"
                        FontFamily="{DynamicResource Font.Family}"
                        FontSize="{DynamicResource Font.Size.Body}" />

                <Button Content="AI grammar check"
                        Click="OnAiGrammarClick"
                        Padding="14,8"
                        Margin="0,0,8,0"
                        Cursor="Hand"
                        ToolTip="Check grammar and phrasing with an AI model (set up in Settings)"
                        FontFamily="{DynamicResource Font.Family}"
                        FontSize="{DynamicResource Font.Size.Body}" />

                <Button Content="+ Add card"
                        Command="{Binding AddCommand}"
                        Padding="16,8"
                        Cursor="Hand"
                        FontFamily="{DynamicResource Font.Family}"
                        FontSize="{DynamicResource Font.Size.Body}"
                        Background="{DynamicResource Brush.Primary}"
                        Foreground="{DynamicResource Brush.OnPrimary}"
                        BorderThickness="0" />
            </StackPanel>
        </Grid>

        <!-- Empty state -->
        <Border Grid.Row="1"
                Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="1"
                CornerRadius="{DynamicResource Radius.Md}"
                Padding="40"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                MaxWidth="460"
                Visibility="{Binding HasCards, Converter={StaticResource BoolVisInv}}">
            <TextBlock Text="{Binding EmptyMessage}"
                       FontFamily="{DynamicResource Font.Family}"
                       FontSize="{DynamicResource Font.Size.Body}"
                       Foreground="{DynamicResource Brush.TextSecondary}"
                       TextWrapping="Wrap"
                       TextAlignment="Center" />
        </Border>

        <!-- Card list -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding HasCards, Converter={StaticResource BoolVis}}">
            <ItemsControl ItemsSource="{Binding Cards}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource Brush.Surface}"
                                BorderBrush="{DynamicResource Brush.Border}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource Radius.Md}"
                                Padding="16"
                                Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Front / back editors -->
                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Text="Front"
                                               FontFamily="{DynamicResource Font.Family}"
                                               FontSize="{DynamicResource Font.Size.Caption}"
                                               Foreground="{DynamicResource Brush.TextSecondary}" />
                                    <TextBox Text="{Binding Front, UpdateSourceTrigger=PropertyChanged}"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             MinLines="2"
                                             MaxLines="6"
                                             VerticalScrollBarVisibility="Auto"
                                             FontFamily="{DynamicResource Font.Family}"
                                             FontSize="{DynamicResource Font.Size.Body}"
                                             Margin="0,2,0,8" />

                                    <Image Source="{Binding FrontImageBytes, Converter={StaticResource BytesToImage}}"
                                           MaxHeight="120"
                                           HorizontalAlignment="Left"
                                           Stretch="Uniform"
                                           Margin="0,0,0,4"
                                           Visibility="{Binding HasFrontImage, Converter={StaticResource BoolVis}}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <Button Content="Add front image"
                                                Click="OnAddFrontImageClick"
                                                Tag="{Binding}"
                                                Padding="8,4"
                                                Cursor="Hand"
                                                FontFamily="{DynamicResource Font.Family}"
                                                FontSize="{DynamicResource Font.Size.Caption}"
                                                Background="Transparent"
                                                Foreground="{DynamicResource Brush.TextPrimary}"
                                                BorderBrush="{DynamicResource Brush.Border}"
                                                BorderThickness="1"
                                                Visibility="{Binding HasFrontImage, Converter={StaticResource BoolVisInv}}" />
                                        <Button Content="Remove front image"
                                                Command="{Binding RemoveFrontImageCommand}"
                                                Padding="8,4"
                                                Cursor="Hand"
                                                FontFamily="{DynamicResource Font.Family}"
                                                FontSize="{DynamicResource Font.Size.Caption}"
                                                Background="Transparent"
                                                Foreground="{DynamicResource Brush.Error}"
                                                BorderBrush="{DynamicResource Brush.Border}"
                                                BorderThickness="1"
                                                Visibility="{Binding HasFrontImage, Converter={StaticResource BoolVis}}" />
                                    </StackPanel>

                                    <TextBlock Text="Back"
                                               FontFamily="{DynamicResource Font.Family}"
                                               FontSize="{DynamicResource Font.Size.Caption}"
                                               Foreground="{DynamicResource Brush.TextSecondary}" />
                                    <TextBox Text="{Binding Back, UpdateSourceTrigger=PropertyChanged}"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             MinLines="2"
                                             MaxLines="6"
                                             VerticalScrollBarVisibility="Auto"
                                             FontFamily="{DynamicResource Font.Family}"
                                             FontSize="{DynamicResource Font.Size.Body}"
                                             Margin="0,2,0,0" />

                                    <Image Source="{Binding BackImageBytes, Converter={StaticResource BytesToImage}}"
                                           MaxHeight="120"
                                           HorizontalAlignment="Left"
                                           Stretch="Uniform"
                                           Margin="0,4,0,4"
                                           Visibility="{Binding HasBackImage, Converter={StaticResource BoolVis}}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <Button Content="Add back image"
                                                Click="OnAddBackImageClick"
                                                Tag="{Binding}"
                                                Padding="8,4"
                                                Cursor="Hand"
                                                FontFamily="{DynamicResource Font.Family}"
                                                FontSize="{DynamicResource Font.Size.Caption}"
                                                Background="Transparent"
                                                Foreground="{DynamicResource Brush.TextPrimary}"
                                                BorderBrush="{DynamicResource Brush.Border}"
                                                BorderThickness="1"
                                                Visibility="{Binding HasBackImage, Converter={StaticResource BoolVisInv}}" />
                                        <Button Content="Remove back image"
                                                Command="{Binding RemoveBackImageCommand}"
                                                Padding="8,4"
                                                Cursor="Hand"
                                                FontFamily="{DynamicResource Font.Family}"
                                                FontSize="{DynamicResource Font.Size.Caption}"
                                                Background="Transparent"
                                                Foreground="{DynamicResource Brush.Error}"
                                                BorderBrush="{DynamicResource Brush.Border}"
                                                BorderThickness="1"
                                                Visibility="{Binding HasBackImage, Converter={StaticResource BoolVis}}" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- Reorder / remove -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Top">
                                    <Button Content="↑"
                                            Command="{Binding DataContext.MoveUpCommand,
                                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            Width="32" Height="32"
                                            Margin="0,0,0,4"
                                            Cursor="Hand"
                                            ToolTip="Move up"
                                            Background="Transparent"
                                            Foreground="{DynamicResource Brush.TextPrimary}"
                                            BorderBrush="{DynamicResource Brush.Border}"
                                            BorderThickness="1" />
                                    <Button Content="↓"
                                            Command="{Binding DataContext.MoveDownCommand,
                                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            Width="32" Height="32"
                                            Margin="0,0,0,4"
                                            Cursor="Hand"
                                            ToolTip="Move down"
                                            Background="Transparent"
                                            Foreground="{DynamicResource Brush.TextPrimary}"
                                            BorderBrush="{DynamicResource Brush.Border}"
                                            BorderThickness="1" />
                                    <Button Content="✕"
                                            Command="{Binding DataContext.RemoveCommand,
                                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            Width="32" Height="32"
                                            Cursor="Hand"
                                            ToolTip="Remove card"
                                            Background="Transparent"
                                            Foreground="{DynamicResource Brush.Error}"
                                            BorderBrush="{DynamicResource Brush.Border}"
                                            BorderThickness="1" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
