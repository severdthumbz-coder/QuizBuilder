<UserControl x:Class="QuizBuilder.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:QuizBuilder.App.Converters">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolVis" />

        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource Radius.Md}" />
            <Setter Property="Padding" Value="{DynamicResource Thickness.Md}" />
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>

        <Style x:Key="SectionHeading" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource Font.Family}" />
            <Setter Property="FontSize" Value="{DynamicResource Font.Size.Subtitle}" />
            <Setter Property="FontWeight" Value="{DynamicResource Font.Weight.Bold}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource Font.Family}" />
            <Setter Property="FontSize" Value="{DynamicResource Font.Size.Caption}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <Style TargetType="RadioButton">
            <Setter Property="FontFamily" Value="{DynamicResource Font.Family}" />
            <Setter Property="FontSize" Value="{DynamicResource Font.Size.Body}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="FontFamily" Value="{DynamicResource Font.Family}" />
            <Setter Property="FontSize" Value="{DynamicResource Font.Size.Body}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Focusable="False">
        <StackPanel Margin="{DynamicResource Thickness.Lg}" MaxWidth="760" HorizontalAlignment="Left">

            <TextBlock Text="Settings"
                       FontFamily="{DynamicResource Font.Family}"
                       FontSize="{DynamicResource Font.Size.Headline}"
                       FontWeight="{DynamicResource Font.Weight.Bold}"
                       Foreground="{DynamicResource Brush.TextPrimary}" />

            <TextBlock Text="Saved automatically to settings.json beside the application. Nothing is written to the registry or AppData."
                       Margin="0,4,0,20"
                       TextWrapping="Wrap"
                       FontFamily="{DynamicResource Font.Family}"
                       FontSize="{DynamicResource Font.Size.Body}"
                       Foreground="{DynamicResource Brush.TextSecondary}" />

            <!-- Grading scope -->
            <Border Style="{StaticResource SectionCard}">
                <StackPanel>
                    <TextBlock Text="Grading scope" Style="{StaticResource SectionHeading}" />
                    <TextBlock Text="Which sections count towards the mark." Style="{StaticResource Hint}" />
                    <RadioButton GroupName="Scope" Content="Grade every section"
                                 IsChecked="{Binding GradeAllSections}" />
                    <RadioButton GroupName="Scope" Content="Choose sections when the quiz is taken"
                                 IsChecked="{Binding SelectSectionsAtQuizTime}" />

                    <Border BorderBrush="{DynamicResource Brush.Border}"
                            BorderThickness="0,1,0,0"
                            Margin="0,14,0,12" />

                    <TextBlock Text="Pass mark" Style="{StaticResource SectionHeading}" />
                    <TextBlock Text="What the pass mark counts."
                               Style="{StaticResource Hint}" />

                    <RadioButton GroupName="PassBasis"
                                 Content="A percentage of the questions"
                                 IsChecked="{Binding PassByQuestionCount}" />
                    <RadioButton GroupName="PassBasis"
                                 Content="A percentage of the points"
                                 IsChecked="{Binding PassByTotalPoints}" />

                    <TextBlock Text="{Binding PassMarkBasisHint}"
                               Style="{StaticResource Hint}"
                               Margin="0,6,0,0" />

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <!-- LostFocus, not PropertyChanged: the setter clamps to
                             0-100, so typing "100" would clamp the intermediate
                             "1" and echo it back, making the field untypeable. -->
                        <TextBox Text="{Binding PassPercentage, UpdateSourceTrigger=LostFocus}"
                                 Width="70"
                                 Padding="8,6"
                                 HorizontalContentAlignment="Right"
                                 FontFamily="{DynamicResource Font.Family}"
                                 FontSize="{DynamicResource Font.Size.Body}"
                                 BorderBrush="{DynamicResource Brush.Border}"
                                 BorderThickness="1"
                                 AutomationProperties.Name="Pass mark percentage" />

                        <TextBlock Text="%"
                                   VerticalAlignment="Center"
                                   Margin="8,0,0,0"
                                   FontFamily="{DynamicResource Font.Family}"
                                   FontSize="{DynamicResource Font.Size.Body}"
                                   Foreground="{DynamicResource Brush.TextSecondary}" />
                    </StackPanel>

                    <TextBlock Text="{Binding PassMarkSummary}"
                               Style="{StaticResource Hint}"
                               Margin="0,8,0,0" />

                    <TextBlock Text="A pass mark of 0% means everyone passes."
                               Style="{StaticResource Hint}"
                               Foreground="{DynamicResource Brush.Warning}"
                               Visibility="{Binding ShowPassMarkWarning, Converter={StaticResource BoolVis}}" />
                </StackPanel>
            </Border>

            <!-- Flash cards -->
            <Border Style="{StaticResource SectionCard}">
                <StackPanel>
                    <TextBlock Text="Flash cards" Style="{StaticResource SectionHeading}" />
                    <TextBlock Text="Where the Flash Cards tab draws its cards from."
                               Style="{StaticResource Hint}" />

                    <RadioButton GroupName="FlashSource"
                                 Content="The quiz questions and their answers"
                                 IsChecked="{Binding FlashFromQuiz}" />
                    <RadioButton GroupName="FlashSource"
                                 Content="The study cards"
                                 IsChecked="{Binding FlashFromStudyCards}" />
                    <RadioButton GroupName="FlashSource"
                                 Content="Both — questions, then study cards"
                                 IsChecked="{Binding FlashFromBoth}" />

                    <TextBlock Text="Author study cards in the Study Cards tab."
                               Style="{StaticResource Hint}"
                               Margin="0,6,0,0" />
                </StackPanel>
            </Border>

            <!-- Question selection -->
            <Border Style="{StaticResource SectionCard}">
                <StackPanel>
                    <TextBlock Text="Question selection" Style="{StaticResource SectionHeading}" />
                    <TextBlock Text="How many questions to draw from each section." Style="{StaticResource Hint}" />
                    <RadioButton GroupName="Selection" Content="Use every question"
                                 IsChecked="{Binding UseAllQuestions}" />
                    <RadioButton GroupName="Selection" Content="Use a set number per section"
                                 IsChecked="{Binding UseExactCount}" />
                    <RadioButton GroupName="Selection" Content="Use a total number, spread across sections"
                                 IsChecked="{Binding UseTotalCount}" />

                    <TextBlock Text="Add sections on the Quiz Builder tab to set per-section counts."
                               Style="{StaticResource Hint}"
                               Margin="24,4,0,0"
                               Visibility="{Binding HasNoSections, Converter={StaticResource BoolVis}}" />

                    <!-- Per-section counts (exact-count mode) -->
                    <ItemsControl ItemsSource="{Binding SectionCounts}"
                                  Margin="24,10,0,0"
                                  Visibility="{Binding ShowPerSectionCounts, Converter={StaticResource BoolVis}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Title}"
                                               VerticalAlignment="Center"
                                               FontFamily="{DynamicResource Font.Family}"
                                               FontSize="{DynamicResource Font.Size.Body}"
                                               Foreground="{DynamicResource Brush.TextPrimary}" />
                                    <TextBox Grid.Column="1"
                                             Width="56"
                                             Text="{Binding Count, UpdateSourceTrigger=LostFocus}"
                                             FontFamily="{DynamicResource Font.Family}"
                                             FontSize="{DynamicResource Font.Size.Body}" />
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding PoolLabel}"
                                               VerticalAlignment="Center"
                                               Margin="8,0,0,0"
                                               FontFamily="{DynamicResource Font.Family}"
                                               FontSize="{DynamicResource Font.Size.Caption}"
                                               Foreground="{DynamicResource Brush.TextSecondary}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Total count (proportional mode) -->
                    <StackPanel Margin="24,10,0,0"
                                Visibility="{Binding ShowTotalCount, Converter={StaticResource BoolVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Total questions:"
                                       VerticalAlignment="Center"
                                       FontFamily="{DynamicResource Font.Family}"
                                       FontSize="{DynamicResource Font.Size.Body}"
                                       Foreground="{DynamicResource Brush.TextPrimary}" />
                            <TextBox Width="64"
                                     Margin="8,0,0,0"
                                     Text="{Binding TotalQuestionCount, UpdateSourceTrigger=LostFocus}"
                                     FontFamily="{DynamicResource Font.Family}"
                                     FontSize="{DynamicResource Font.Size.Body}" />
                        </StackPanel>
                        <TextBlock Text="{Binding TotalCountSummary}"
                                   Style="{StaticResource Hint}"
                                   Margin="0,6,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Randomisation -->
            <Border Style="{StaticResource SectionCard}">
                <StackPanel>
                    <TextBlock Text="Randomisation" Style="{StaticResource SectionHeading}" />
                    <TextBlock Text="Shuffle to discourage copying. Each can be toggled independently."
                               Style="{StaticResource Hint}" />
                    <CheckBox Content="Randomise question order"
                              IsChecked="{Binding RandomizeQuestionOrder}" />
                    <CheckBox Content="Randomise answer-choice order"
                              IsChecked="{Binding RandomizeAnswerOrder}" />
                </StackPanel>
            </Border>

            <!-- Timing -->
            <Border Style="{StaticResource SectionCard}">
                <StackPanel>
                    <TextBlock Text="Time limit" Style="{StaticResource SectionHeading}" />
                    <TextBlock Text="Applies to the published web quiz." Style="{StaticResource Hint}" />
                    <CheckBox Content="Limit how long the quiz can take"
                              IsChecked="{Binding HasTimeLimit}" />

                    <StackPanel Orientation="Horizontal" Margin="24,6,0,0"
                                Visibility="{Binding HasTimeLimit, Converter={StaticResource BoolVis}}">
                        <TextBox Text="{Binding TimeLimitMinutes, UpdateSourceTrigger=LostFocus}"
                                 Width="70" Padding="6,4"
                                 FontFamily="{DynamicResource Font.Family.Mono}"
                                 FontSize="{DynamicResource Font.Size.Body}" />
                        <TextBlock Text="minutes" Margin="8,0,0,0" VerticalAlignment="Center"
                                   FontFamily="{DynamicResource Font.Family}"
                                   FontSize="{DynamicResource Font.Size.Body}"
                                   Foreground="{DynamicResource Brush.TextSecondary}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Undo -->
            <Border Style="{StaticResource SectionCard}">
                <StackPanel>
                    <TextBlock Text="Undo" Style="{StaticResource SectionHeading}" />
                    <TextBlock Text="How far back Ctrl+Z can step through structural changes."
                               Style="{StaticResource Hint}" />

                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="Remember" VerticalAlignment="Center"
                                   FontFamily="{DynamicResource Font.Family}"
                                   FontSize="{DynamicResource Font.Size.Body}"
                                   Foreground="{DynamicResource Brush.TextSecondary}" />
                        <TextBox Text="{Binding UndoDepth, UpdateSourceTrigger=LostFocus}"
                                 Width="60" Margin="8,0" Padding="6,4"
                                 HorizontalContentAlignment="Right"
                                 FontFamily="{DynamicResource Font.Family.Mono}"
                                 FontSize="{DynamicResource Font.Size.Body}"
                                 AutomationProperties.Name="Undo steps" />
                        <TextBlock VerticalAlignment="Center"
                                   FontFamily="{DynamicResource Font.Family}"
                                   FontSize="{DynamicResource Font.Size.Body}"
                                   Foreground="{DynamicResource Brush.TextSecondary}">
                            <Run Text="steps" /><Run Text=" (" /><Run Text="{Binding UndoMinDepth, Mode=OneWay}" /><Run Text="-" /><Run Text="{Binding UndoMaxDepth, Mode=OneWay}" /><Run Text=", 0 turns undo off)" />
                        </TextBlock>
                    </StackPanel>

                    <!-- Each step holds a whole copy of the document, so the
                         cost of a large number is worth stating plainly. -->
                    <TextBlock Text="{Binding UndoStatus}"
                               Style="{StaticResource Hint}"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <!-- Autosave -->
            <Border Style="{StaticResource SectionCard}">
                <StackPanel>
                    <TextBlock Text="Autosave" Style="{StaticResource SectionHeading}" />
                    <TextBlock Text="Periodically save the open session back to its .qbx file."
                               Style="{StaticResource Hint}" />

                    <CheckBox Content="Save automatically while I work"
                              IsChecked="{Binding AutoSaveEnabled}" />

                    <StackPanel Orientation="Horizontal" Margin="24,6,0,0"
                                Visibility="{Binding AutoSaveEnabled, Converter={StaticResource BoolVis}}">
                        <TextBlock Text="Every" VerticalAlignment="Center"
                                   FontFamily="{DynamicResource Font.Family}"
                                   FontSize="{DynamicResource Font.Size.Body}"
                                   Foreground="{DynamicResource Brush.TextSecondary}" />
                        <TextBox Text="{Binding AutoSaveIntervalMinutes, UpdateSourceTrigger=LostFocus}"
                                 Width="60" Margin="8,0" Padding="6,4"
                                 HorizontalContentAlignment="Right"
                                 FontFamily="{DynamicResource Font.Family.Mono}"
                                 FontSize="{DynamicResource Font.Size.Body}" />
                        <TextBlock VerticalAlignment="Center"
                                   FontFamily="{DynamicResource Font.Family}"
                                   FontSize="{DynamicResource Font.Size.Body}"
                                   Foreground="{DynamicResource Brush.TextSecondary}">
                            <Run Text="minutes" /><Run Text=" (" /><Run Text="{Binding AutoSaveMinInterval, Mode=OneWay}" /><Run Text="-" /><Run Text="{Binding AutoSaveMaxInterval, Mode=OneWay}" /><Run Text=")" />
                        </TextBlock>
                    </StackPanel>

                    <!-- Autosave cannot write to a session that has never been
                         saved. Say so rather than let the user switch it on and
                         quietly discover it never fired. -->
                    <Border Margin="24,10,0,0" Padding="10,8"
                            CornerRadius="{DynamicResource Radius.Sm}"
                            Background="{DynamicResource Brush.SurfaceSunken}"
                            BorderBrush="{DynamicResource Brush.Warning}"
                            BorderThickness="0,0,0,2"
                            Visibility="{Binding ShowAutoSaveCaveat, Converter={StaticResource BoolVis}}">
                        <TextBlock Text="Autosave needs a file to write to. It starts once you have saved this quiz as a .qbx file at least once. Saving arrives with the Quiz Builder tab."
                                   TextWrapping="Wrap"
                                   FontFamily="{DynamicResource Font.Family}"
                                   FontSize="{DynamicResource Font.Size.Caption}"
                                   Foreground="{DynamicResource Brush.TextPrimary}" />
                    </Border>

                    <TextBlock Text="{Binding AutoSaveStatus}"
                               Margin="24,8,0,0"
                               TextWrapping="Wrap"
                               FontFamily="{DynamicResource Font.Family}"
                               FontSize="{DynamicResource Font.Size.Caption}"
                               Foreground="{DynamicResource Brush.TextSecondary}"
                               Visibility="{Binding AutoSaveEnabled, Converter={StaticResource BoolVis}}" />
                </StackPanel>
            </Border>

            <!-- Default points -->
            <Border Style="{StaticResource SectionCard}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Default point values" Style="{StaticResource SectionHeading}" />
                            <TextBlock Text="Applied to new questions. Any question can be overridden individually."
                                       Style="{StaticResource Hint}" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="Reset"
                                Command="{Binding ResetDefaultsCommand}"
                                VerticalAlignment="Top"
                                MinHeight="28" Padding="12,4" Cursor="Hand"
                                FontFamily="{DynamicResource Font.Family}"
                                FontSize="{DynamicResource Font.Size.Caption}"
                                Background="Transparent"
                                Foreground="{DynamicResource Brush.TextPrimary}"
                                BorderBrush="{DynamicResource Brush.Border}"
                                BorderThickness="1" />
                    </Grid>

                    <ItemsControl ItemsSource="{Binding DefaultPoints}" Margin="0,6,0,0" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Label}"
                                               VerticalAlignment="Center"
                                               FontFamily="{DynamicResource Font.Family}"
                                               FontSize="{DynamicResource Font.Size.Body}"
                                               Foreground="{DynamicResource Brush.TextPrimary}" />
                                    <TextBox Grid.Column="1"
                                             Text="{Binding Points, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.##}}"
                                             Width="70" Padding="6,4"
                                             HorizontalContentAlignment="Right"
                                             FontFamily="{DynamicResource Font.Family.Mono}"
                                             FontSize="{DynamicResource Font.Size.Body}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Token protection -->
            <Border Style="{StaticResource SectionCard}">
                <StackPanel>
                    <TextBlock Text="GitHub token storage" Style="{StaticResource SectionHeading}" />
                    <TextBlock Text="There is no universally right answer here, so it is your call."
                               Style="{StaticResource Hint}" />

                    <RadioButton GroupName="Token" IsChecked="{Binding TokenMachineBound}">
                        <StackPanel>
                            <TextBlock Text="Machine-bound (recommended)"
                                       FontFamily="{DynamicResource Font.Family}"
                                       FontSize="{DynamicResource Font.Size.Body}"
                                       Foreground="{DynamicResource Brush.TextPrimary}" />
                            <TextBlock Text="Strongest protection. Encrypted to this Windows account, so it will not decrypt if you move the app to another machine."
                                       TextWrapping="Wrap" MaxWidth="600"
                                       FontFamily="{DynamicResource Font.Family}"
                                       FontSize="{DynamicResource Font.Size.Caption}"
                                       Foreground="{DynamicResource Brush.TextSecondary}" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton GroupName="Token" IsChecked="{Binding TokenPassphrase}" Margin="0,8,0,6">
                        <StackPanel>
                            <TextBlock Text="Passphrase"
                                       FontFamily="{DynamicResource Font.Family}"
                                       FontSize="{DynamicResource Font.Size.Body}"
                                       Foreground="{DynamicResource Brush.TextPrimary}" />
                            <TextBlock Text="Travels with the app on a USB stick. Costs one passphrase prompt per session."
                                       TextWrapping="Wrap" MaxWidth="600"
                                       FontFamily="{DynamicResource Font.Family}"
                                       FontSize="{DynamicResource Font.Size.Caption}"
                                       Foreground="{DynamicResource Brush.TextSecondary}" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton GroupName="Token" IsChecked="{Binding TokenNone}" Margin="0,8,0,6">
                        <StackPanel>
                            <TextBlock Text="Do not save"
                                       FontFamily="{DynamicResource Font.Family}"
                                       FontSize="{DynamicResource Font.Size.Body}"
                                       Foreground="{DynamicResource Brush.TextPrimary}" />
                            <TextBlock Text="Nothing is written to disk. Re-enter the token each session."
                                       TextWrapping="Wrap" MaxWidth="600"
                                       FontFamily="{DynamicResource Font.Family}"
                                       FontSize="{DynamicResource Font.Size.Caption}"
                                       Foreground="{DynamicResource Brush.TextSecondary}" />
                        </StackPanel>
                    </RadioButton>

                    <Border Margin="0,10,0,0" Padding="10,8"
                            CornerRadius="{DynamicResource Radius.Sm}"
                            Background="{DynamicResource Brush.SurfaceSunken}"
                            BorderBrush="{DynamicResource Brush.Warning}"
                            BorderThickness="0,0,0,2"
                            Visibility="{Binding ShowTokenModeWarning, Converter={StaticResource BoolVis}}">
                        <TextBlock Text="{Binding TokenModeWarning}"
                                   TextWrapping="Wrap"
                                   FontFamily="{DynamicResource Font.Family}"
                                   FontSize="{DynamicResource Font.Size.Caption}"
                                   Foreground="{DynamicResource Brush.TextPrimary}" />
                    </Border>

                    <Button Content="Clear saved token"
                            Command="{Binding ClearTokenCommand}"
                            HorizontalAlignment="Left" Margin="0,10,0,0"
                            MinHeight="28" Padding="12,4" Cursor="Hand"
                            FontFamily="{DynamicResource Font.Family}"
                            FontSize="{DynamicResource Font.Size.Caption}"
                            Background="Transparent"
                            Foreground="{DynamicResource Brush.Error}"
                            BorderBrush="{DynamicResource Brush.Border}"
                            BorderThickness="1"
                            Visibility="{Binding HasStoredToken, Converter={StaticResource BoolVis}}" />
                </StackPanel>
            </Border>

            <!-- Spelling dictionary -->
            <Border Style="{StaticResource SectionCard}">
                <StackPanel>
                    <TextBlock Text="Spelling dictionary" Style="{StaticResource SectionHeading}" />
                    <TextBlock Text="Words you've added from &quot;Check spelling&quot; — the checker treats these as correct everywhere. Add domain terms here (e.g. licensure, subagent) so they stop being flagged."
                               Style="{StaticResource Hint}"
                               TextWrapping="Wrap" />

                    <!-- Add a word -->
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBox Width="220"
                                 VerticalContentAlignment="Center"
                                 Padding="6,4"
                                 FontFamily="{DynamicResource Font.Family}"
                                 FontSize="{DynamicResource Font.Size.Body}"
                                 Text="{Binding NewSpellWord, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Content="Add word"
                                Command="{Binding AddSpellWordCommand}"
                                Margin="8,0,0,0"
                                Padding="12,4"
                                Cursor="Hand"
                                FontFamily="{DynamicResource Font.Family}"
                                FontSize="{DynamicResource Font.Size.Body}" />
                    </StackPanel>

                    <!-- Current words -->
                    <ItemsControl ItemsSource="{Binding SpellWords}" Margin="0,12,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource Brush.SurfaceSunken}"
                                        Padding="8,4" Margin="0,0,0,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Word}"
                                                   VerticalAlignment="Center"
                                                   FontFamily="{DynamicResource Font.Family}"
                                                   FontSize="{DynamicResource Font.Size.Body}"
                                                   Foreground="{DynamicResource Brush.TextPrimary}" />
                                        <Button Grid.Column="1"
                                                Content="Remove"
                                                Command="{Binding RemoveCommand}"
                                                Padding="8,2"
                                                Cursor="Hand"
                                                Background="Transparent"
                                                Foreground="{DynamicResource Brush.Error}"
                                                BorderBrush="{DynamicResource Brush.Border}"
                                                BorderThickness="1"
                                                FontFamily="{DynamicResource Font.Family}"
                                                FontSize="{DynamicResource Font.Size.Caption}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Your dictionary is empty. Words you add here or via &quot;Check spelling&quot; will appear in this list."
                               Style="{StaticResource Hint}"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0"
                               Visibility="{Binding HasNoSpellWords, Converter={StaticResource BoolVis}}" />
                </StackPanel>
            </Border>

            <!-- File location -->
            <Border Style="{StaticResource SectionCard}" Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="Settings file" Style="{StaticResource SectionHeading}" />
                    <TextBlock Text="{Binding SettingsFilePath}"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0"
                               FontFamily="{DynamicResource Font.Family.Mono}"
                               FontSize="{DynamicResource Font.Size.Caption}"
                               Foreground="{DynamicResource Brush.TextSecondary}" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
