<UserControl x:Class="QuizBuilder.App.Views.FlashCardsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:QuizBuilder.App.Converters">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolVis" />
        <conv:BoolToVisibilityConverter x:Key="BoolVisInv" Invert="True" />
        <conv:BytesToImageConverter x:Key="BytesToImage" />
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Flash cards"
                       FontFamily="{DynamicResource Font.Family}"
                       FontSize="{DynamicResource Font.Size.Title}"
                       FontWeight="{DynamicResource Font.Weight.Bold}"
                       Foreground="{DynamicResource Brush.TextPrimary}" />

            <TextBlock Text="Click a card to flip between the question and its answer. For review — nothing is marked."
                       FontFamily="{DynamicResource Font.Family}"
                       FontSize="{DynamicResource Font.Size.Caption}"
                       Foreground="{DynamicResource Brush.TextSecondary}"
                       TextWrapping="Wrap"
                       Margin="0,4,0,0" />
        </StackPanel>

        <!-- Empty state -->
        <Border Grid.Row="1"
                Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="1"
                CornerRadius="{DynamicResource Radius.Md}"
                Padding="40"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                MaxWidth="440"
                Visibility="{Binding HasCards, Converter={StaticResource BoolVisInv}}">
            <TextBlock Text="{Binding EmptyMessage}"
                       FontFamily="{DynamicResource Font.Family}"
                       FontSize="{DynamicResource Font.Size.Body}"
                       Foreground="{DynamicResource Brush.TextSecondary}"
                       TextWrapping="Wrap"
                       TextAlignment="Center" />
        </Border>

        <!-- The card -->
        <Button Grid.Row="1"
                Command="{Binding FlipCommand}"
                Visibility="{Binding HasCards, Converter={StaticResource BoolVis}}"
                Cursor="Hand"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Background="Transparent"
                BorderThickness="0"
                Padding="0"
                AutomationProperties.Name="Flip card">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <!--
                        Stretch to the space the row gives rather than a fixed
                        size, so maximising the window makes the card bigger and
                        restoring it down shrinks it again. The maximums stop a
                        very wide monitor turning the card into a letterbox that
                        is harder to read, not easier; the minimums keep it a
                        card rather than a sliver on a small window.
                    -->
                    <Border Background="{DynamicResource Brush.Surface}"
                            BorderBrush="{DynamicResource Brush.Border}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource Radius.Lg}"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            MinWidth="360"
                            MinHeight="260"
                            MaxWidth="1100"
                            MaxHeight="800"
                            Padding="32">
                        <Grid>
                            <!-- Front: the question -->
                            <StackPanel VerticalAlignment="Center"
                                        Visibility="{Binding ShowingBack, Converter={StaticResource BoolVisInv}}">
                                <TextBlock Text="{Binding Current.TypeLabel}"
                                           FontFamily="{DynamicResource Font.Family}"
                                           FontSize="{Binding CardCaptionSize}"
                                           Foreground="{DynamicResource Brush.TextSecondary}"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,16" />

                                <TextBlock Text="{Binding Current.Front}"
                                           FontFamily="{DynamicResource Font.Family}"
                                           FontSize="{Binding CardFontSize}"
                                           Foreground="{DynamicResource Brush.TextPrimary}"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center" />

                                <Image Source="{Binding CurrentImageBytes, Converter={StaticResource BytesToImage}}"
                                       MaxHeight="200"
                                       Stretch="Uniform"
                                       Margin="0,16,0,0"
                                       Visibility="{Binding HasCurrentImage, Converter={StaticResource BoolVis}}" />
                            </StackPanel>

                            <!-- Back: the answer -->
                            <StackPanel VerticalAlignment="Center"
                                        Visibility="{Binding ShowingBack, Converter={StaticResource BoolVis}}">
                                <TextBlock Text="Answer"
                                           FontFamily="{DynamicResource Font.Family}"
                                           FontSize="{Binding CardCaptionSize}"
                                           Foreground="{DynamicResource Brush.TextSecondary}"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,16" />

                                <TextBlock Text="{Binding Current.Back}"
                                           FontFamily="{DynamicResource Font.Family}"
                                           FontSize="{Binding CardFontSize}"
                                           Foreground="{DynamicResource Brush.TextPrimary}"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center" />

                                <Image Source="{Binding CurrentImageBytes, Converter={StaticResource BytesToImage}}"
                                       MaxHeight="200"
                                       Stretch="Uniform"
                                       Margin="0,16,0,0"
                                       Visibility="{Binding HasCurrentImage, Converter={StaticResource BoolVis}}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Button.Template>
        </Button>

        <!-- Footer: navigation -->
        <Grid Grid.Row="2"
              Margin="0,16,0,0"
              Visibility="{Binding HasCards, Converter={StaticResource BoolVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Content="Shuffle"
                    Command="{Binding ShuffleCommand}"
                    HorizontalAlignment="Left"
                    Padding="16,8"
                    Cursor="Hand"
                    FontFamily="{DynamicResource Font.Family}"
                    FontSize="{DynamicResource Font.Size.Body}"
                    Background="Transparent"
                    Foreground="{DynamicResource Brush.TextPrimary}"
                    BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="1" />

            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="‹ Previous"
                        Command="{Binding PreviousCommand}"
                        Margin="0,0,8,0"
                        Padding="16,8"
                        Cursor="Hand"
                        FontFamily="{DynamicResource Font.Family}"
                        FontSize="{DynamicResource Font.Size.Body}"
                        Background="Transparent"
                        Foreground="{DynamicResource Brush.TextPrimary}"
                        BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="1" />

                <Border Padding="12,8" MinWidth="90">
                    <TextBlock Text="{Binding ProgressLabel}"
                               FontFamily="{DynamicResource Font.Family}"
                               FontSize="{DynamicResource Font.Size.Body}"
                               Foreground="{DynamicResource Brush.TextSecondary}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>

                <Button Content="Next ›"
                        Command="{Binding NextCommand}"
                        Margin="8,0,0,0"
                        Padding="16,8"
                        Cursor="Hand"
                        FontFamily="{DynamicResource Font.Family}"
                        FontSize="{DynamicResource Font.Size.Body}"
                        Background="{DynamicResource Brush.Primary}"
                        Foreground="{DynamicResource Brush.OnPrimary}"
                        BorderThickness="0" />
            </StackPanel>

            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">

                <!--
                    Text size. Buttons rather than a slider: the useful range is
                    eight discrete steps, and a stepper is reachable by keyboard
                    without dragging anything.
                -->
                <TextBlock Text="Text"
                           FontFamily="{DynamicResource Font.Family}"
                           FontSize="{DynamicResource Font.Size.Caption}"
                           Foreground="{DynamicResource Brush.TextSecondary}"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0" />

                <Button Content="&#xE738;"
                        FontFamily="Segoe MDL2 Assets"
                        Command="{Binding SmallerTextCommand}"
                        Padding="10,6"
                        Cursor="Hand"
                        Background="Transparent"
                        Foreground="{DynamicResource Brush.TextPrimary}"
                        BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="1"
                        ToolTip="Smaller text"
                        AutomationProperties.Name="Smaller card text" />

                <TextBlock Text="{Binding TextScaleLabel}"
                           FontFamily="{DynamicResource Font.Family.Mono}"
                           FontSize="{DynamicResource Font.Size.Caption}"
                           Foreground="{DynamicResource Brush.TextSecondary}"
                           VerticalAlignment="Center"
                           TextAlignment="Center"
                           MinWidth="48"
                           Margin="4,0" />

                <Button Content="&#xE710;"
                        FontFamily="Segoe MDL2 Assets"
                        Command="{Binding BiggerTextCommand}"
                        Padding="10,6"
                        Cursor="Hand"
                        Background="Transparent"
                        Foreground="{DynamicResource Brush.TextPrimary}"
                        BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="1"
                        ToolTip="Bigger text"
                        AutomationProperties.Name="Bigger card text" />

                <TextBlock Text="{Binding FlipHint}"
                           FontFamily="{DynamicResource Font.Family}"
                           FontSize="{DynamicResource Font.Size.Caption}"
                           Foreground="{DynamicResource Brush.TextSecondary}"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           MaxWidth="150"
                           TextAlignment="Right"
                           Margin="12,0,0,0" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
