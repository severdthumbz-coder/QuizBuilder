<UserControl x:Class="QuizBuilder.App.Views.ThemeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:QuizBuilder.App.Converters">

    <UserControl.Resources>
        <conv:HexToBrushConverter x:Key="HexBrush" />
        <conv:BoolToVisibilityConverter x:Key="BoolVis" />
        <conv:BoolToVisibilityConverter x:Key="BoolVisInv" Invert="True" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Focusable="False">
        <StackPanel Margin="{DynamicResource Thickness.Lg}" MaxWidth="900" HorizontalAlignment="Left">

            <TextBlock Text="Theme and layout"
                       FontFamily="{DynamicResource Font.Family}"
                       FontSize="{DynamicResource Font.Size.Headline}"
                       FontWeight="{DynamicResource Font.Weight.Bold}"
                       Foreground="{DynamicResource Brush.TextPrimary}" />

            <TextBlock Margin="0,4,0,0"
                       TextWrapping="Wrap"
                       FontFamily="{DynamicResource Font.Family}"
                       FontSize="{DynamicResource Font.Size.Body}"
                       Foreground="{DynamicResource Brush.TextSecondary}">
                <Run Text="Currently using" /><Run Text=" " /><Run Text="{Binding ActiveThemeName, Mode=OneWay}"
                     FontWeight="{DynamicResource Font.Weight.Bold}" /><Run Text="." />
                <Run Text="Changes apply everywhere: the app, printed documents and the published web quiz." />
            </TextBlock>

            <!-- Built-in themes -->
            <TextBlock Text="Built-in themes"
                       Margin="0,28,0,0"
                       FontFamily="{DynamicResource Font.Family}"
                       FontSize="{DynamicResource Font.Size.Title}"
                       FontWeight="{DynamicResource Font.Weight.Bold}"
                       Foreground="{DynamicResource Brush.TextPrimary}" />

            <ItemsControl ItemsSource="{Binding Choices}" Margin="0,12,0,0" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Command="{Binding DataContext.SelectThemeCommand,
                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                Margin="0,0,12,12"
                                Padding="0"
                                Cursor="Hand"
                                BorderThickness="0"
                                Background="Transparent"
                                AutomationProperties.Name="{Binding DisplayName}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Card"
                                            Width="180"
                                            Background="{DynamicResource Brush.Surface}"
                                            BorderBrush="{DynamicResource Brush.Border}"
                                            BorderThickness="1"
                                            CornerRadius="{DynamicResource Radius.Md}">
                                        <StackPanel>
                                            <!-- Preview: the theme's own colours,
                                                 not the active theme's -->
                                            <Border Height="72"
                                                    CornerRadius="4,4,0,0"
                                                    Background="{Binding BackgroundHex, Converter={StaticResource HexBrush}}">
                                                <StackPanel VerticalAlignment="Center"
                                                            HorizontalAlignment="Center"
                                                            Orientation="Horizontal">
                                                    <Border Width="28" Height="28" CornerRadius="4" Margin="3,0"
                                                            Background="{Binding PrimaryHex, Converter={StaticResource HexBrush}}" />
                                                    <Border Width="28" Height="28" CornerRadius="4" Margin="3,0"
                                                            Background="{Binding AccentHex, Converter={StaticResource HexBrush}}" />
                                                    <Border Width="28" Height="28" CornerRadius="4" Margin="3,0"
                                                            BorderBrush="#40000000" BorderThickness="1"
                                                            Background="{Binding SurfaceHex, Converter={StaticResource HexBrush}}" />
                                                </StackPanel>
                                            </Border>

                                            <StackPanel Margin="12,10,12,12">
                                                <TextBlock Text="{Binding DisplayName}"
                                                           FontFamily="{DynamicResource Font.Family}"
                                                           FontSize="{DynamicResource Font.Size.Body}"
                                                           FontWeight="{DynamicResource Font.Weight.Bold}"
                                                           Foreground="{DynamicResource Brush.TextPrimary}" />
                                                <TextBlock Text="{Binding FontSummary}"
                                                           Margin="0,2,0,0"
                                                           FontFamily="{DynamicResource Font.Family}"
                                                           FontSize="{DynamicResource Font.Size.Caption}"
                                                           Foreground="{DynamicResource Brush.TextSecondary}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <ControlTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                            <Setter TargetName="Card" Property="BorderBrush"
                                                    Value="{DynamicResource Brush.Primary}" />
                                            <Setter TargetName="Card" Property="BorderThickness" Value="2" />
                                        </DataTrigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Card" Property="BorderBrush"
                                                    Value="{DynamicResource Brush.BorderStrong}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Custom theme -->
            <TextBlock Text="Custom theme"
                       Margin="0,20,0,0"
                       FontFamily="{DynamicResource Font.Family}"
                       FontSize="{DynamicResource Font.Size.Title}"
                       FontWeight="{DynamicResource Font.Weight.Bold}"
                       Foreground="{DynamicResource Brush.TextPrimary}" />

            <!-- Empty state -->
            <Border Margin="0,12,0,0"
                    Padding="{DynamicResource Thickness.Md}"
                    Background="{DynamicResource Brush.SurfaceSunken}"
                    BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource Radius.Md}"
                    Visibility="{Binding HasCustom, Converter={StaticResource BoolVisInv}}">
                <StackPanel>
                    <TextBlock Text="No custom theme yet"
                               FontFamily="{DynamicResource Font.Family}"
                               FontSize="{DynamicResource Font.Size.Body}"
                               FontWeight="{DynamicResource Font.Weight.Bold}"
                               Foreground="{DynamicResource Brush.TextPrimary}" />
                    <TextBlock Text="Start from whichever built-in theme is closest to what you want, then adjust it. The original stays untouched."
                               Margin="0,4,0,10"
                               TextWrapping="Wrap"
                               FontFamily="{DynamicResource Font.Family}"
                               FontSize="{DynamicResource Font.Size.Caption}"
                               Foreground="{DynamicResource Brush.TextSecondary}" />
                    <Button Content="Create from current theme"
                            Command="{Binding CustomiseCommand}"
                            HorizontalAlignment="Left"
                            MinHeight="32"
                            Padding="14,6"
                            Cursor="Hand"
                            FontFamily="{DynamicResource Font.Family}"
                            FontSize="{DynamicResource Font.Size.Body}"
                            Background="{DynamicResource Brush.Primary}"
                            Foreground="{DynamicResource Brush.OnPrimary}"
                            BorderThickness="0" />
                </StackPanel>
            </Border>

            <!-- Editor -->
            <Border Margin="0,12,0,24"
                    Padding="{DynamicResource Thickness.Md}"
                    Background="{DynamicResource Brush.Surface}"
                    BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource Radius.Md}"
                    Visibility="{Binding HasCustom, Converter={StaticResource BoolVis}}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="Adjust the values below. Changes preview live."
                                   VerticalAlignment="Center"
                                   FontFamily="{DynamicResource Font.Family}"
                                   FontSize="{DynamicResource Font.Size.Caption}"
                                   Foreground="{DynamicResource Brush.TextSecondary}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="Use custom"
                                    Command="{Binding UseCustomCommand}"
                                    Margin="0,0,8,0" MinHeight="30" Padding="12,4" Cursor="Hand"
                                    FontFamily="{DynamicResource Font.Family}"
                                    FontSize="{DynamicResource Font.Size.Caption}"
                                    Background="{DynamicResource Brush.Accent}"
                                    Foreground="{DynamicResource Brush.OnAccent}"
                                    BorderThickness="0"
                                    Visibility="{Binding IsCustomActive, Converter={StaticResource BoolVisInv}}" />
                            <Button Content="Save"
                                    Command="{Binding SaveCustomCommand}"
                                    Margin="0,0,6,0"
                                    MinHeight="30" Padding="12,4" Cursor="Hand"
                                    FontFamily="{DynamicResource Font.Family}"
                                    FontSize="{DynamicResource Font.Size.Caption}"
                                    Background="{DynamicResource Brush.Primary}"
                                    Foreground="{DynamicResource Brush.OnPrimary}"
                                    BorderThickness="0" />
                            <Button Content="Discard"
                                    Command="{Binding DiscardCustomCommand}"
                                    Margin="0,0,6,0"
                                    MinHeight="30" Padding="12,4" Cursor="Hand"
                                    FontFamily="{DynamicResource Font.Family}"
                                    FontSize="{DynamicResource Font.Size.Caption}"
                                    Background="Transparent"
                                    Foreground="{DynamicResource Brush.TextPrimary}"
                                    BorderBrush="{DynamicResource Brush.Border}"
                                    BorderThickness="1" />
                            <Button Content="Delete"
                                    Command="{Binding DeleteCustomCommand}"
                                    MinHeight="30" Padding="12,4" Cursor="Hand"
                                    FontFamily="{DynamicResource Font.Family}"
                                    FontSize="{DynamicResource Font.Size.Caption}"
                                    Background="Transparent"
                                    Foreground="{DynamicResource Brush.Error}"
                                    BorderBrush="{DynamicResource Brush.Border}"
                                    BorderThickness="1" />
                        </StackPanel>
                    </Grid>

                    <!--
                        Says which state the theme is in. Without it the Save and
                        Discard buttons just grey out with no explanation, and the
                        user cannot tell whether their edits are committed.
                    -->
                    <TextBlock Text="{Binding CustomStatus}"
                               FontFamily="{DynamicResource Font.Family}"
                               FontSize="{DynamicResource Font.Size.Caption}"
                               Foreground="{DynamicResource Brush.TextSecondary}"
                               Margin="0,6,0,0" />

                    <Separator Margin="0,12" Background="{DynamicResource Brush.Divider}" />

                    <!-- Colours -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Primary colour" VerticalAlignment="Center"
                                   FontFamily="{DynamicResource Font.Family}"
                                   FontSize="{DynamicResource Font.Size.Body}"
                                   Foreground="{DynamicResource Brush.TextPrimary}" />
                        <TextBox Grid.Column="1" Text="{Binding CustomPrimary, UpdateSourceTrigger=LostFocus}"
                                 MaxWidth="140" HorizontalAlignment="Left"
                                 FontFamily="{DynamicResource Font.Family.Mono}"
                                 FontSize="{DynamicResource Font.Size.Body}"
                                 Padding="6,4" />
                        <Border Grid.Column="2" Width="32" Height="24" CornerRadius="3"
                                BorderBrush="{DynamicResource Brush.BorderStrong}" BorderThickness="1"
                                Background="{Binding CustomPrimary, Converter={StaticResource HexBrush}}" />
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Accent colour" VerticalAlignment="Center"
                                   FontFamily="{DynamicResource Font.Family}"
                                   FontSize="{DynamicResource Font.Size.Body}"
                                   Foreground="{DynamicResource Brush.TextPrimary}" />
                        <TextBox Grid.Column="1" Text="{Binding CustomAccent, UpdateSourceTrigger=LostFocus}"
                                 MaxWidth="140" HorizontalAlignment="Left"
                                 FontFamily="{DynamicResource Font.Family.Mono}"
                                 FontSize="{DynamicResource Font.Size.Body}"
                                 Padding="6,4" />
                        <Border Grid.Column="2" Width="32" Height="24" CornerRadius="3"
                                BorderBrush="{DynamicResource Brush.BorderStrong}" BorderThickness="1"
                                Background="{Binding CustomAccent, Converter={StaticResource HexBrush}}" />
                    </Grid>

                    <!-- Font -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Font" VerticalAlignment="Center"
                                   FontFamily="{DynamicResource Font.Family}"
                                   FontSize="{DynamicResource Font.Size.Body}"
                                   Foreground="{DynamicResource Brush.TextPrimary}" />
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding FontOptions}"
                                  SelectedItem="{Binding CustomFontFamily}"
                                  MaxWidth="320" HorizontalAlignment="Left"
                                  FontFamily="{DynamicResource Font.Family}"
                                  FontSize="{DynamicResource Font.Size.Body}" />
                    </Grid>

                    <!-- Sliders -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="50" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Base font size" VerticalAlignment="Center"
                                   FontFamily="{DynamicResource Font.Family}"
                                   FontSize="{DynamicResource Font.Size.Body}"
                                   Foreground="{DynamicResource Brush.TextPrimary}" />
                        <Slider Grid.Column="1" VerticalAlignment="Center"
                                Minimum="{Binding MinFontSize}" Maximum="{Binding MaxFontSize}"
                                Value="{Binding CustomFontSize}"
                                TickFrequency="1" IsSnapToTickEnabled="True" MaxWidth="320"
                                HorizontalAlignment="Left" Width="320" />
                        <TextBlock Grid.Column="2" Text="{Binding CustomFontSize, StringFormat={}{0:0}}"
                                   VerticalAlignment="Center" Margin="8,0,0,0"
                                   FontFamily="{DynamicResource Font.Family.Mono}"
                                   FontSize="{DynamicResource Font.Size.Caption}"
                                   Foreground="{DynamicResource Brush.TextSecondary}" />
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="50" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Corner radius" VerticalAlignment="Center"
                                   FontFamily="{DynamicResource Font.Family}"
                                   FontSize="{DynamicResource Font.Size.Body}"
                                   Foreground="{DynamicResource Brush.TextPrimary}" />
                        <Slider Grid.Column="1" VerticalAlignment="Center"
                                Minimum="{Binding MinRadius}" Maximum="{Binding MaxRadius}"
                                Value="{Binding CustomCornerRadius}"
                                TickFrequency="1" IsSnapToTickEnabled="True"
                                HorizontalAlignment="Left" Width="320" />
                        <TextBlock Grid.Column="2" Text="{Binding CustomCornerRadius, StringFormat={}{0:0}}"
                                   VerticalAlignment="Center" Margin="8,0,0,0"
                                   FontFamily="{DynamicResource Font.Family.Mono}"
                                   FontSize="{DynamicResource Font.Size.Caption}"
                                   Foreground="{DynamicResource Brush.TextSecondary}" />
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="50" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Spacing unit" VerticalAlignment="Center"
                                   FontFamily="{DynamicResource Font.Family}"
                                   FontSize="{DynamicResource Font.Size.Body}"
                                   Foreground="{DynamicResource Brush.TextPrimary}" />
                        <Slider Grid.Column="1" VerticalAlignment="Center"
                                Minimum="{Binding MinSpacing}" Maximum="{Binding MaxSpacing}"
                                Value="{Binding CustomSpacingUnit}"
                                TickFrequency="1" IsSnapToTickEnabled="True"
                                HorizontalAlignment="Left" Width="320" />
                        <TextBlock Grid.Column="2" Text="{Binding CustomSpacingUnit, StringFormat={}{0:0}}"
                                   VerticalAlignment="Center" Margin="8,0,0,0"
                                   FontFamily="{DynamicResource Font.Family.Mono}"
                                   FontSize="{DynamicResource Font.Size.Caption}"
                                   Foreground="{DynamicResource Brush.TextSecondary}" />
                    </Grid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
