<UserControl x:Class="QuizBuilder.App.Views.HelpView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:QuizBuilder.App.Converters">

    <UserControl.Resources>
        <conv:BoolToStringConverter x:Key="StatusGlyph" TrueValue="&#xE73E;" FalseValue="&#xE7C3;" />
        <conv:BoolToBrushConverter x:Key="StatusBrush"
                                   TrueResourceKey="Brush.Success"
                                   FalseResourceKey="Brush.TextDisabled" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Focusable="False">
        <StackPanel Margin="{DynamicResource Thickness.Lg}" MaxWidth="820" HorizontalAlignment="Left">

            <TextBlock Text="Help &amp; About"
                       FontFamily="{DynamicResource Font.Family}"
                       FontSize="{DynamicResource Font.Size.Headline}"
                       FontWeight="{DynamicResource Font.Weight.Bold}"
                       Foreground="{DynamicResource Brush.TextPrimary}" />

            <TextBlock Text="{Binding VersionDisplay}"
                       Margin="0,4,0,0"
                       FontFamily="{DynamicResource Font.Family}"
                       FontSize="{DynamicResource Font.Size.Subtitle}"
                       Foreground="{DynamicResource Brush.TextSecondary}" />

            <!-- Recommended workflow -->
            <TextBlock Text="Recommended workflow"
                       Margin="0,32,0,0"
                       FontFamily="{DynamicResource Font.Family}"
                       FontSize="{DynamicResource Font.Size.Title}"
                       FontWeight="{DynamicResource Font.Weight.Bold}"
                       Foreground="{DynamicResource Brush.TextPrimary}" />

            <ItemsControl ItemsSource="{Binding Workflow}" Margin="0,12,0,0"
                          Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource Brush.Surface}"
                                BorderBrush="{DynamicResource Brush.Border}"
                                BorderThickness="{DynamicResource Border.Width}"
                                CornerRadius="{DynamicResource Radius.Md}"
                                Padding="{DynamicResource Thickness.Md}"
                                Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        Width="28" Height="28"
                                        VerticalAlignment="Top"
                                        CornerRadius="{DynamicResource Radius.Pill}"
                                        Background="{DynamicResource Brush.Primary}">
                                    <TextBlock Text="{Binding Number}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontFamily="{DynamicResource Font.Family}"
                                               FontSize="{DynamicResource Font.Size.Caption}"
                                               FontWeight="{DynamicResource Font.Weight.Bold}"
                                               Foreground="{DynamicResource Brush.OnPrimary}" />
                                </Border>

                                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                    <TextBlock Text="{Binding Title}"
                                               FontFamily="{DynamicResource Font.Family}"
                                               FontSize="{DynamicResource Font.Size.Body}"
                                               FontWeight="{DynamicResource Font.Weight.Bold}"
                                               Foreground="{DynamicResource Brush.TextPrimary}" />
                                    <TextBlock Text="{Binding Detail}"
                                               Margin="0,4,0,0"
                                               TextWrapping="Wrap"
                                               FontFamily="{DynamicResource Font.Family}"
                                               FontSize="{DynamicResource Font.Size.Body}"
                                               Foreground="{DynamicResource Brush.TextSecondary}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Features -->
            <TextBlock Text="Features"
                       Margin="0,32,0,0"
                       FontFamily="{DynamicResource Font.Family}"
                       FontSize="{DynamicResource Font.Size.Title}"
                       FontWeight="{DynamicResource Font.Weight.Bold}"
                       Foreground="{DynamicResource Brush.TextPrimary}" />

            <TextBlock Text="A tick marks a feature that works today. A dash marks one that is planned but not yet built."
                       Margin="0,4,0,0"
                       TextWrapping="Wrap"
                       FontFamily="{DynamicResource Font.Family}"
                       FontSize="{DynamicResource Font.Size.Caption}"
                       Foreground="{DynamicResource Brush.TextSecondary}" />

            <ItemsControl ItemsSource="{Binding Features}" Margin="0,12,0,0"
                          Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="{Binding Implemented, Converter={StaticResource StatusGlyph}}"
                                       Foreground="{Binding Implemented, Converter={StaticResource StatusBrush}}"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="14"
                                       Width="20"
                                       VerticalAlignment="Top"
                                       Margin="0,2,0,0" />

                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="{Binding Name}"
                                           FontFamily="{DynamicResource Font.Family}"
                                           FontSize="{DynamicResource Font.Size.Body}"
                                           FontWeight="{DynamicResource Font.Weight.Medium}"
                                           Foreground="{DynamicResource Brush.TextPrimary}" />
                                <TextBlock Text="{Binding Description}"
                                           TextWrapping="Wrap"
                                           FontFamily="{DynamicResource Font.Family}"
                                           FontSize="{DynamicResource Font.Size.Caption}"
                                           Foreground="{DynamicResource Brush.TextSecondary}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Version history -->
            <TextBlock Text="Version history"
                       Margin="0,32,0,0"
                       FontFamily="{DynamicResource Font.Family}"
                       FontSize="{DynamicResource Font.Size.Title}"
                       FontWeight="{DynamicResource Font.Weight.Bold}"
                       Foreground="{DynamicResource Brush.TextPrimary}" />

            <ItemsControl ItemsSource="{Binding GroupedHistory}" Margin="0,12,0,24"
                          Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource Brush.Surface}"
                                BorderBrush="{DynamicResource Brush.Border}"
                                BorderThickness="{DynamicResource Border.Width}"
                                CornerRadius="{DynamicResource Radius.Md}"
                                Padding="{DynamicResource Thickness.Md}"
                                Margin="0,0,0,8">
                            <StackPanel>
                                <!-- Version header, shown once per version. -->
                                <TextBlock FontFamily="{DynamicResource Font.Family}"
                                           FontSize="{DynamicResource Font.Size.Subtitle}"
                                           FontWeight="{DynamicResource Font.Weight.Bold}"
                                           Foreground="{DynamicResource Brush.TextPrimary}">
                                    <Run Text="v" /><Run Text="{Binding Version, Mode=OneWay}" />
                                </TextBlock>

                                <!-- Each build shipped under this version. -->
                                <ItemsControl ItemsSource="{Binding Builds}" Margin="0,4,0,0"
                                              Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,8,0,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock FontFamily="{DynamicResource Font.Family}"
                                                               FontSize="{DynamicResource Font.Size.Caption}"
                                                               FontWeight="{DynamicResource Font.Weight.Bold}"
                                                               Foreground="{DynamicResource Brush.TextPrimary}">
                                                        <Run Text="build " /><Run Text="{Binding Build, Mode=OneWay}" />
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding ReleaseDate}"
                                                               Margin="12,0,0,0"
                                                               VerticalAlignment="Center"
                                                               FontFamily="{DynamicResource Font.Family}"
                                                               FontSize="{DynamicResource Font.Size.Caption}"
                                                               Foreground="{DynamicResource Brush.TextSecondary}" />
                                                </StackPanel>

                                                <ItemsControl ItemsSource="{Binding Changes}" Margin="0,4,0,0"
                                                              Focusable="False">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,0,0,4">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0" Text="&#x2022;"
                                                                           Foreground="{DynamicResource Brush.Accent}"
                                                                           FontSize="{DynamicResource Font.Size.Body}" />
                                                                <TextBlock Grid.Column="1" Text="{Binding}"
                                                                           Margin="8,0,0,0"
                                                                           TextWrapping="Wrap"
                                                                           FontFamily="{DynamicResource Font.Family}"
                                                                           FontSize="{DynamicResource Font.Size.Caption}"
                                                                           Foreground="{DynamicResource Brush.TextSecondary}" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</UserControl>
