<Window x:Class="QuizBuilder.App.Views.GrammarCheckWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:QuizBuilder.App.Converters"
        Title="AI grammar check"
        Height="660" Width="760"
        MinHeight="460" MinWidth="600"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Background}">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolVis" />
        <conv:BoolToVisibilityConverter x:Key="BoolVisInvert" Invert="True" />

        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource Font.Family}" />
            <Setter Property="FontSize" Value="{DynamicResource Font.Size.Body}" />
            <Setter Property="FontWeight" Value="{DynamicResource Font.Weight.Bold}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        </Style>

        <Style x:Key="Body" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource Font.Family}" />
            <Setter Property="FontSize" Value="{DynamicResource Font.Size.Body}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource Font.Family}" />
            <Setter Property="FontSize" Value="{DynamicResource Font.Size.Caption}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="Action" TargetType="Button">
            <Setter Property="FontFamily" Value="{DynamicResource Font.Family}" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="MinWidth" Value="72" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Scope + run -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="Check:" Style="{StaticResource Body}"
                       VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox Grid.Column="1" HorizontalAlignment="Left" Width="280"
                      ItemsSource="{Binding ScopeOptions}"
                      DisplayMemberPath="Label"
                      SelectedItem="{Binding SelectedScope}"
                      IsEnabled="{Binding IsIdle}" />

            <Button Grid.Column="2" Content="Run check"
                    Style="{StaticResource Action}"
                    Click="OnRunClick"
                    IsEnabled="{Binding CanRun}"
                    Background="{DynamicResource Brush.Primary}"
                    Foreground="{DynamicResource Brush.OnPrimary}"
                    BorderThickness="0" />
            <Button Grid.Column="3" Content="Cancel"
                    Style="{StaticResource Action}"
                    Click="OnCancelClick"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}" />
        </Grid>

        <!-- Status -->
        <Border Grid.Row="1" Margin="0,0,0,10" Padding="10,8"
                Background="{DynamicResource Brush.SurfaceSunken}">
            <TextBlock Text="{Binding StatusMessage}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource Body}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasError}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Error}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Border>

        <!-- Suggestions -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding HasSuggestions, Converter={StaticResource BoolVis}}">
            <ItemsControl ItemsSource="{Binding Suggestions}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource Brush.Surface}"
                                BorderBrush="{DynamicResource Brush.Border}"
                                BorderThickness="1"
                                Padding="12,10" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock Text="{Binding Where}" Style="{StaticResource Caption}" />
                                    <TextBlock Style="{StaticResource Body}" Margin="0,2,0,0">
                                        <Run Text="{Binding Original, Mode=OneWay}"
                                             Foreground="{DynamicResource Brush.Error}"
                                             TextDecorations="Strikethrough" />
                                        <Run Text="  →  " Foreground="{DynamicResource Brush.TextSecondary}" />
                                        <Run Text="{Binding Rewrite, Mode=OneWay}"
                                             Foreground="{DynamicResource Brush.Success}" />
                                    </TextBlock>
                                    <TextBlock Text="{Binding Explanation}" Style="{StaticResource Caption}"
                                               Margin="0,4,0,0" />
                                    <TextBlock Text="Can't auto-apply in the description — edit it directly."
                                               Style="{StaticResource Caption}"
                                               Foreground="{DynamicResource Brush.Warning}"
                                               Margin="0,4,0,0"
                                               Visibility="{Binding CanAccept, Converter={StaticResource BoolVisInvert}}" />
                                </StackPanel>

                                <Button Grid.Column="1" Content="Accept"
                                        Style="{StaticResource Action}"
                                        IsEnabled="{Binding CanAccept}"
                                        Click="OnAcceptClick" Tag="{Binding}" />
                                <Button Grid.Column="2" Content="Reject"
                                        Style="{StaticResource Action}"
                                        Click="OnRejectClick" Tag="{Binding}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Footer -->
        <StackPanel Grid.Row="3" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Accept all"
                    Style="{StaticResource Action}"
                    Command="{Binding AcceptAllCommand}"
                    Visibility="{Binding HasSuggestions, Converter={StaticResource BoolVis}}" />
            <Button Content="Close"
                    Style="{StaticResource Action}"
                    Click="OnCloseClick"
                    Background="{DynamicResource Brush.Primary}"
                    Foreground="{DynamicResource Brush.OnPrimary}"
                    BorderThickness="0" />
        </StackPanel>
    </Grid>
</Window>
