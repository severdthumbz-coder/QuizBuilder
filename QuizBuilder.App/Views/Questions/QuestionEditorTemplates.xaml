<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:QuizBuilder.App.ViewModels.Questions"
                    xmlns:conv="clr-namespace:QuizBuilder.App.Converters">

    <conv:BoolToVisibilityConverter x:Key="BoolVis" />

    <!--
      One DataTemplate per question type, selected by ViewModel type.

      This is the opposite of the shell's approach (views resolved from DI) and
      deliberately so. The shell has seven fixed views built once at startup,
      where a silent DataContext failure leaves a blank tab forever. These
      editors are created per question as the user clicks around; DI cannot
      resolve "an editor for THIS question object" without a factory per type.
      DataTemplate maps ViewModel -> View, which is precisely this job, and a
      missing template renders the type name rather than nothing.
    -->

    <Style x:Key="EditorLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.Caption}" />
        <Setter Property="FontWeight" Value="{DynamicResource Font.Weight.Medium}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <Style x:Key="EditorTextBox" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.Body}" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style x:Key="SmallButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.Caption}" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!-- Shared: prompt, points, hint. Every type has these. -->
    <DataTemplate x:Key="CommonFieldsTemplate">
        <StackPanel>
            <TextBlock Text="Question text" Style="{StaticResource EditorLabel}" />
            <TextBox Text="{Binding Prompt, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource EditorTextBox}"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     MinHeight="60"
                     VerticalScrollBarVisibility="Auto" />

            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,20,0">
                    <TextBlock Text="Points" Style="{StaticResource EditorLabel}" />
                    <TextBox Text="{Binding Points, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.##}}"
                             Style="{StaticResource EditorTextBox}"
                             Width="70"
                             HorizontalContentAlignment="Right" />
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="Hint (optional)" Style="{StaticResource EditorLabel}" />
                    <TextBox Text="{Binding Hint, UpdateSourceTrigger=LostFocus}"
                             Style="{StaticResource EditorTextBox}" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </DataTemplate>

    <!-- Choice row, shared by both multiple-choice types -->
    <DataTemplate x:Key="ChoiceRowTemplate">
        <Grid Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <CheckBox Grid.Column="0"
                      IsChecked="{Binding IsCorrect}"
                      VerticalAlignment="Center"
                      Margin="0,0,8,0"
                      Cursor="Hand"
                      ToolTip="Mark as a correct answer"
                      AutomationProperties.Name="Correct answer" />

            <TextBox Grid.Column="1"
                     Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource EditorTextBox}" />

            <Button Grid.Column="2"
                    Content="&#xE711;"
                    FontFamily="Segoe MDL2 Assets"
                    Margin="6,0,0,0"
                    Style="{StaticResource SmallButton}"
                    Foreground="{DynamicResource Brush.Error}"
                    ToolTip="Remove this option"
                    AutomationProperties.Name="Remove option"
                    Command="{Binding DataContext.RemoveChoiceCommand,
                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                    CommandParameter="{Binding}"
                    IsEnabled="{Binding DataContext.CanRemoveChoices,
                                RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
        </Grid>
    </DataTemplate>

    <!-- Multiple choice, single answer -->
    <DataTemplate DataType="{x:Type vm:MultipleChoiceSingleEditorViewModel}">
        <StackPanel>
            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource CommonFieldsTemplate}" />

            <TextBlock Text="Options" Style="{StaticResource EditorLabel}" Margin="0,16,0,4" />
            <TextBlock Text="Tick exactly one option as the correct answer."
                       FontFamily="{DynamicResource Font.Family}"
                       FontSize="{DynamicResource Font.Size.Caption}"
                       Foreground="{DynamicResource Brush.TextSecondary}"
                       Margin="0,0,0,8" />

            <ItemsControl ItemsSource="{Binding Choices}"
                          ItemTemplate="{StaticResource ChoiceRowTemplate}"
                          Focusable="False" />

            <Button Content="Add option"
                    Command="{Binding AddChoiceCommand}"
                    Style="{StaticResource SmallButton}"
                    HorizontalAlignment="Left"
                    Margin="0,4,0,0" />
        </StackPanel>
    </DataTemplate>

    <!-- Multiple choice, several answers -->
    <DataTemplate DataType="{x:Type vm:MultipleChoiceMultipleEditorViewModel}">
        <StackPanel>
            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource CommonFieldsTemplate}" />

            <TextBlock Text="Options" Style="{StaticResource EditorLabel}" Margin="0,16,0,4" />
            <TextBlock Text="Tick every option that counts as correct."
                       FontFamily="{DynamicResource Font.Family}"
                       FontSize="{DynamicResource Font.Size.Caption}"
                       Foreground="{DynamicResource Brush.TextSecondary}"
                       Margin="0,0,0,8" />

            <ItemsControl ItemsSource="{Binding Choices}"
                          ItemTemplate="{StaticResource ChoiceRowTemplate}"
                          Focusable="False" />

            <Button Content="Add option"
                    Command="{Binding AddChoiceCommand}"
                    Style="{StaticResource SmallButton}"
                    HorizontalAlignment="Left"
                    Margin="0,4,0,0" />

            <CheckBox Content="Award partial credit for each correct selection"
                      IsChecked="{Binding AllowPartialCredit}"
                      Margin="0,12,0,0"
                      Cursor="Hand"
                      FontFamily="{DynamicResource Font.Family}"
                      FontSize="{DynamicResource Font.Size.Body}"
                      Foreground="{DynamicResource Brush.TextPrimary}" />
        </StackPanel>
    </DataTemplate>

    <!-- True / False -->
    <DataTemplate DataType="{x:Type vm:TrueFalseEditorViewModel}">
        <StackPanel>
            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource CommonFieldsTemplate}" />

            <TextBlock Text="Correct answer" Style="{StaticResource EditorLabel}" Margin="0,16,0,4" />
            <StackPanel Orientation="Horizontal">
                <RadioButton Content="True"
                             IsChecked="{Binding AnswerIsTrue}"
                             Margin="0,0,20,0"
                             Cursor="Hand"
                             FontFamily="{DynamicResource Font.Family}"
                             FontSize="{DynamicResource Font.Size.Body}"
                             Foreground="{DynamicResource Brush.TextPrimary}" />
                <RadioButton Content="False"
                             IsChecked="{Binding AnswerIsFalse}"
                             Cursor="Hand"
                             FontFamily="{DynamicResource Font.Family}"
                             FontSize="{DynamicResource Font.Size.Body}"
                             Foreground="{DynamicResource Brush.TextPrimary}" />
            </StackPanel>
        </StackPanel>
    </DataTemplate>

    <!-- Answer row, shared by short answer and fill-in-the-blank -->
    <DataTemplate x:Key="AnswerRowTemplate">
        <Grid Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0"
                     Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource EditorTextBox}" />

            <Button Grid.Column="1"
                    Content="&#xE711;"
                    FontFamily="Segoe MDL2 Assets"
                    Margin="6,0,0,0"
                    Style="{StaticResource SmallButton}"
                    Foreground="{DynamicResource Brush.Error}"
                    ToolTip="Remove this answer"
                    AutomationProperties.Name="Remove answer"
                    Command="{Binding DataContext.RemoveAnswerCommand,
                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                    CommandParameter="{Binding}" />
        </Grid>
    </DataTemplate>

    <!-- Short answer -->
    <DataTemplate DataType="{x:Type vm:ShortAnswerEditorViewModel}">
        <StackPanel>
            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource CommonFieldsTemplate}" />

            <TextBlock Text="Accepted answers" Style="{StaticResource EditorLabel}" Margin="0,16,0,4" />
            <TextBlock Text="Any one of these counts as correct. Add variants for spelling differences."
                       FontFamily="{DynamicResource Font.Family}"
                       FontSize="{DynamicResource Font.Size.Caption}"
                       Foreground="{DynamicResource Brush.TextSecondary}"
                       Margin="0,0,0,8" />

            <ItemsControl ItemsSource="{Binding Answers}"
                          ItemTemplate="{StaticResource AnswerRowTemplate}"
                          Focusable="False" />

            <Button Content="Add accepted answer"
                    Command="{Binding AddAnswerCommand}"
                    Style="{StaticResource SmallButton}"
                    HorizontalAlignment="Left"
                    Margin="0,4,0,0" />

            <CheckBox Content="Case sensitive"
                      IsChecked="{Binding CaseSensitive}"
                      Margin="0,12,0,0"
                      Cursor="Hand"
                      FontFamily="{DynamicResource Font.Family}"
                      FontSize="{DynamicResource Font.Size.Body}"
                      Foreground="{DynamicResource Brush.TextPrimary}" />
        </StackPanel>
    </DataTemplate>

    <!-- Fill in the blank -->
    <DataTemplate DataType="{x:Type vm:FillInTheBlankEditorViewModel}">
        <StackPanel>
            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource CommonFieldsTemplate}" />

            <TextBlock Text="Use {{1}}, {{2}} and so on in the text to mark each blank."
                       FontFamily="{DynamicResource Font.Family}"
                       FontSize="{DynamicResource Font.Size.Caption}"
                       Foreground="{DynamicResource Brush.TextSecondary}"
                       Margin="0,8,0,0" />

            <Button Content="Add a blank"
                    Command="{Binding AddBlankCommand}"
                    Style="{StaticResource SmallButton}"
                    HorizontalAlignment="Left"
                    Margin="0,8,0,0"
                    ToolTip="Appends the next token to the question text" />

            <ItemsControl ItemsSource="{Binding Blanks}" Margin="0,12,0,0" Focusable="False"
                          Visibility="{Binding HasBlanks, Converter={StaticResource BoolVis}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource Brush.SurfaceSunken}"
                                BorderBrush="{DynamicResource Brush.Border}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource Radius.Sm}"
                                Padding="10"
                                Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="{Binding Token}"
                                           FontFamily="{DynamicResource Font.Family.Mono}"
                                           FontSize="{DynamicResource Font.Size.Caption}"
                                           FontWeight="{DynamicResource Font.Weight.Bold}"
                                           Foreground="{DynamicResource Brush.Primary}"
                                           Margin="0,0,0,6" />

                                <ItemsControl ItemsSource="{Binding Answers}"
                                              ItemTemplate="{StaticResource AnswerRowTemplate}"
                                              Focusable="False" />

                                <Button Content="Add accepted answer"
                                        Command="{Binding AddAnswerCommand}"
                                        Style="{StaticResource SmallButton}"
                                        HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <CheckBox Content="Case sensitive"
                      IsChecked="{Binding CaseSensitive}"
                      Margin="0,4,0,0"
                      Cursor="Hand"
                      FontFamily="{DynamicResource Font.Family}"
                      FontSize="{DynamicResource Font.Size.Body}"
                      Foreground="{DynamicResource Brush.TextPrimary}" />
        </StackPanel>
    </DataTemplate>

    <!-- Matching -->
    <DataTemplate DataType="{x:Type vm:MatchingEditorViewModel}">
        <StackPanel>
            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource CommonFieldsTemplate}" />

            <TextBlock Text="Pairs" Style="{StaticResource EditorLabel}" Margin="0,16,0,4" />
            <TextBlock Text="Each left item matches exactly one right item."
                       FontFamily="{DynamicResource Font.Family}"
                       FontSize="{DynamicResource Font.Size.Caption}"
                       Foreground="{DynamicResource Brush.TextSecondary}"
                       Margin="0,0,0,8" />

            <ItemsControl ItemsSource="{Binding Pairs}" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0"
                                     Text="{Binding Left, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource EditorTextBox}" />

                            <TextBlock Grid.Column="1" Text="&#xE72A;"
                                       FontFamily="Segoe MDL2 Assets"
                                       VerticalAlignment="Center"
                                       Margin="8,0"
                                       Foreground="{DynamicResource Brush.TextSecondary}" />

                            <TextBox Grid.Column="2"
                                     Text="{Binding Right, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource EditorTextBox}" />

                            <Button Grid.Column="3"
                                    Content="&#xE711;"
                                    FontFamily="Segoe MDL2 Assets"
                                    Margin="6,0,0,0"
                                    Style="{StaticResource SmallButton}"
                                    Foreground="{DynamicResource Brush.Error}"
                                    ToolTip="Remove this pair"
                                    AutomationProperties.Name="Remove pair"
                                    Command="{Binding DataContext.RemovePairCommand,
                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}"
                                    IsEnabled="{Binding DataContext.CanRemovePairs,
                                                RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Button Content="Add pair"
                    Command="{Binding AddPairCommand}"
                    Style="{StaticResource SmallButton}"
                    HorizontalAlignment="Left"
                    Margin="0,4,0,0" />

            <TextBlock Text="Distractors (optional)" Style="{StaticResource EditorLabel}" Margin="0,16,0,4" />
            <TextBlock Text="Extra right-hand options with no match, to stop students answering by elimination."
                       FontFamily="{DynamicResource Font.Family}"
                       FontSize="{DynamicResource Font.Size.Caption}"
                       Foreground="{DynamicResource Brush.TextSecondary}"
                       Margin="0,0,0,8" />

            <ItemsControl ItemsSource="{Binding Distractors}"
                          ItemTemplate="{StaticResource AnswerRowTemplate}"
                          Focusable="False" />

            <Button Content="Add distractor"
                    Command="{Binding AddDistractorCommand}"
                    Style="{StaticResource SmallButton}"
                    HorizontalAlignment="Left"
                    Margin="0,4,0,0" />
        </StackPanel>
    </DataTemplate>

    <!-- Sequence -->
    <DataTemplate DataType="{x:Type vm:SequenceEditorViewModel}">
        <StackPanel>
            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource CommonFieldsTemplate}" />

            <TextBlock Text="Items in correct order" Style="{StaticResource EditorLabel}" Margin="0,16,0,4" />
            <TextBlock Text="List the items top-to-bottom in the right order. The quiz shuffles them for the student to rearrange."
                       FontFamily="{DynamicResource Font.Family}"
                       FontSize="{DynamicResource Font.Size.Caption}"
                       Foreground="{DynamicResource Brush.TextSecondary}"
                       Margin="0,0,0,8" />

            <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0"
                                     Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource EditorTextBox}" />

                            <Button Grid.Column="1"
                                    Content="&#xE70E;"
                                    FontFamily="Segoe MDL2 Assets"
                                    Margin="6,0,0,0"
                                    Style="{StaticResource SmallButton}"
                                    Foreground="{DynamicResource Brush.TextSecondary}"
                                    ToolTip="Move up"
                                    AutomationProperties.Name="Move item up"
                                    Command="{Binding DataContext.MoveUpCommand,
                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}" />

                            <Button Grid.Column="2"
                                    Content="&#xE70D;"
                                    FontFamily="Segoe MDL2 Assets"
                                    Margin="3,0,0,0"
                                    Style="{StaticResource SmallButton}"
                                    Foreground="{DynamicResource Brush.TextSecondary}"
                                    ToolTip="Move down"
                                    AutomationProperties.Name="Move item down"
                                    Command="{Binding DataContext.MoveDownCommand,
                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}" />

                            <Button Grid.Column="3"
                                    Content="&#xE711;"
                                    FontFamily="Segoe MDL2 Assets"
                                    Margin="6,0,0,0"
                                    Style="{StaticResource SmallButton}"
                                    Foreground="{DynamicResource Brush.Error}"
                                    ToolTip="Remove this item"
                                    AutomationProperties.Name="Remove item"
                                    Command="{Binding DataContext.RemoveItemCommand,
                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}"
                                    IsEnabled="{Binding DataContext.CanRemoveItems,
                                                RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Button Content="Add item"
                    Command="{Binding AddItemCommand}"
                    Style="{StaticResource SmallButton}"
                    HorizontalAlignment="Left"
                    Margin="0,4,0,0" />
        </StackPanel>
    </DataTemplate>

    <!-- Numeric -->
    <DataTemplate DataType="{x:Type vm:NumericEditorViewModel}">
        <StackPanel>
            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource CommonFieldsTemplate}" />

            <TextBlock Text="Correct value" Style="{StaticResource EditorLabel}" Margin="0,16,0,4" />
            <TextBlock Text="The number that counts as correct. Use the tolerance below to accept nearby answers."
                       FontFamily="{DynamicResource Font.Family}"
                       FontSize="{DynamicResource Font.Size.Caption}"
                       Foreground="{DynamicResource Brush.TextSecondary}"
                       Margin="0,0,0,8" />
            <TextBox Text="{Binding TargetText, UpdateSourceTrigger=LostFocus}"
                     Width="200" HorizontalAlignment="Left" Padding="6,4"
                     FontFamily="{DynamicResource Font.Family}"
                     FontSize="{DynamicResource Font.Size.Body}" />

            <TextBlock Text="Tolerance (±)" Style="{StaticResource EditorLabel}" Margin="0,16,0,4" />
            <TextBlock Text="How far from the correct value still counts. Leave at 0 to require an exact match."
                       FontFamily="{DynamicResource Font.Family}"
                       FontSize="{DynamicResource Font.Size.Caption}"
                       Foreground="{DynamicResource Brush.TextSecondary}"
                       Margin="0,0,0,8" />
            <TextBox Text="{Binding ToleranceText, UpdateSourceTrigger=LostFocus}"
                     Width="200" HorizontalAlignment="Left" Padding="6,4"
                     FontFamily="{DynamicResource Font.Family}"
                     FontSize="{DynamicResource Font.Size.Body}" />

            <TextBlock Text="Unit (optional)" Style="{StaticResource EditorLabel}" Margin="0,16,0,4" />
            <TextBox Text="{Binding Unit, UpdateSourceTrigger=LostFocus}"
                     Width="200" HorizontalAlignment="Left" Padding="6,4"
                     FontFamily="{DynamicResource Font.Family}"
                     FontSize="{DynamicResource Font.Size.Body}" />
        </StackPanel>
    </DataTemplate>

    <!-- Dropdown (single choice, shown as a dropdown) -->
    <DataTemplate DataType="{x:Type vm:DropdownEditorViewModel}">
        <StackPanel>
            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource CommonFieldsTemplate}" />

            <TextBlock Text="Options" Style="{StaticResource EditorLabel}" Margin="0,16,0,4" />
            <TextBlock Text="Tick exactly one option as correct. The taker picks from a dropdown."
                       FontFamily="{DynamicResource Font.Family}"
                       FontSize="{DynamicResource Font.Size.Caption}"
                       Foreground="{DynamicResource Brush.TextSecondary}"
                       Margin="0,0,0,8" />

            <ItemsControl ItemsSource="{Binding Choices}"
                          ItemTemplate="{StaticResource ChoiceRowTemplate}"
                          Focusable="False" />

            <Button Content="Add option"
                    Command="{Binding AddChoiceCommand}"
                    Style="{StaticResource SmallButton}"
                    HorizontalAlignment="Left"
                    Margin="0,4,0,0" />
        </StackPanel>
    </DataTemplate>

    <!-- Essay -->
    <DataTemplate DataType="{x:Type vm:EssayEditorViewModel}">
        <StackPanel>
            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource CommonFieldsTemplate}" />

            <TextBlock Text="Grading notes (optional)" Style="{StaticResource EditorLabel}" Margin="0,16,0,4" />
            <TextBlock Text="Shown to whoever grades this. Not shown to the student."
                       FontFamily="{DynamicResource Font.Family}"
                       FontSize="{DynamicResource Font.Size.Caption}"
                       Foreground="{DynamicResource Brush.TextSecondary}"
                       Margin="0,0,0,6" />
            <TextBox Text="{Binding RubricNotes, UpdateSourceTrigger=LostFocus}"
                     Style="{StaticResource EditorTextBox}"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     MinHeight="80"
                     VerticalScrollBarVisibility="Auto" />

            <TextBlock Text="Suggested word count" Style="{StaticResource EditorLabel}" Margin="0,16,0,4" />
            <StackPanel Orientation="Horizontal">
                <TextBox Text="{Binding SuggestedWordCount, UpdateSourceTrigger=LostFocus}"
                         Style="{StaticResource EditorTextBox}"
                         Width="80"
                         HorizontalContentAlignment="Right" />
                <TextBlock Text="words (0 for no suggestion)"
                           VerticalAlignment="Center"
                           Margin="8,0,0,0"
                           FontFamily="{DynamicResource Font.Family}"
                           FontSize="{DynamicResource Font.Size.Caption}"
                           Foreground="{DynamicResource Brush.TextSecondary}" />
            </StackPanel>
        </StackPanel>
    </DataTemplate>

</ResourceDictionary>
