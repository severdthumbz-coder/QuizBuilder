<?xml version="1.0" encoding="UTF-8" ?>
<Application
    x:Class="QuizBuilder.Player.App"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:svc="clr-namespace:QuizBuilder.Player.Services">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Shared converters, referenced by pages via StaticResource. -->
            <svc:NotEmptyConverter x:Key="NotEmpty" />
            <svc:InverseBoolConverter x:Key="InverseBool" />
            <svc:BytesToImageSourceConverter x:Key="BytesToImage" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
