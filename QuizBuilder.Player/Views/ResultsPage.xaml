<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="QuizBuilder.Player.Views.ResultsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:QuizBuilder.Player.ViewModels"
    x:DataType="vm:ResultsViewModel"
    Title="Results"
    Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16" MaximumWidthRequest="560" HorizontalOptions="Center">

            <Label Text="{Binding QuizTitle}" Style="{StaticResource Muted}" HorizontalOptions="Center" Margin="0,8,0,0" />
            <Label Text="{Binding TakerName}" Style="{StaticResource Subtitle}" HorizontalOptions="Center" />

            <!-- Score card -->
            <Border Style="{StaticResource Card}" Padding="24">
                <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                    <Label Text="{Binding ScoreHeadline}" Style="{StaticResource Headline}"
                           FontSize="52" HorizontalOptions="Center" />
                    <Label Text="{Binding ScoreDetail}" Style="{StaticResource Muted}" HorizontalOptions="Center" />

                    <!-- Pass / fail chip: color plus text, never color alone. -->
                    <Border IsVisible="{Binding HasPassFail}" Padding="20,6" Margin="0,8,0,0"
                            HorizontalOptions="Center" StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding IsPass}" Value="True">
                                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SuccessLight}, Dark={StaticResource SuccessDark}}" />
                            </DataTrigger>
                            <DataTrigger TargetType="Border" Binding="{Binding IsFail}" Value="True">
                                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource ErrorLight}, Dark={StaticResource ErrorDark}}" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Label Text="{Binding PassFailText}" FontAttributes="Bold"
                               TextColor="{StaticResource White}" />
                    </Border>
                </VerticalStackLayout>
            </Border>

            <!-- Manual-review note -->
            <Border Style="{StaticResource Card}" IsVisible="{Binding ReviewNote, Converter={StaticResource NotEmpty}}"
                    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceVariantLight}, Dark={StaticResource SurfaceVariantDark}}">
                <Label Text="{Binding ReviewNote}" Style="{StaticResource Muted}" FontSize="14" />
            </Border>

            <!-- Email primary action -->
            <Button Text="{Binding EmailButtonText}" Style="{StaticResource PrimaryButton}"
                    Command="{Binding EmailResultsCommand}" Margin="0,8,0,0" />
            <Label Text="{Binding EmailStatus}" Style="{StaticResource Muted}" FontSize="13"
                   HorizontalTextAlignment="Center"
                   IsVisible="{Binding EmailStatus, Converter={StaticResource NotEmpty}}" />

            <!-- Secondary actions -->
            <Button Text="Take another quiz" Style="{StaticResource SecondaryButton}"
                    Command="{Binding TakeAnotherCommand}" Margin="0,8,0,0" />
            <Button Text="Finish" Style="{StaticResource SecondaryButton}"
                    Command="{Binding DoneCommand}" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
